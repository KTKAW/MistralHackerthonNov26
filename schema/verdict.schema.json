{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://le-chonk.dev/schema/verdict.schema.json",
  "title": "verdict",
  "type": "object",
  "required": ["repo", "advisory", "verdict", "reason", "path", "proof", "suite", "follow_ups"],
  "properties": {
    "repo": { "type": "string" },
    "advisory": {
      "type": "object",
      "required": ["id", "package", "affected_range", "flawed_function"],
      "properties": {
        "id": { "type": "string", "description": "e.g. CVE-2026-96760" },
        "package": { "type": "string" },
        "affected_range": { "type": "string" },
        "flawed_function": { "type": "string" }
      }
    },
    "verdict": { "enum": ["not_affected", "affected_proven", "affected_fixed", "needs_human"] },
    "reason": { "type": "string", "description": "one paragraph; for not_affected, why no reachable path was found" },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "note"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "note": { "type": "string" }
        }
      },
      "description": "entry point -> flawed function, or where the trail stops"
    },
    "proof": {
      "type": "array",
      "items": { "type": "string" },
      "description": "LIST of test IDs (a list, never one string). Each must FAIL on the vulnerable version and PASS on the fixed version"
    },
    "fix": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "enum": ["upgrade", "patch"] },
        "target": { "type": "string", "description": "upgrade target version" },
        "diff_file": { "type": ["string", "null"], "description": "name of the diff file for a patch" }
      }
    },
    "suite": {
      "type": "object",
      "properties": {
        "before": { "$ref": "#/$defs/counts" },
        "after": { "$ref": "#/$defs/counts" }
      }
    },
    "follow_ups": { "type": "array", "items": { "type": "string" } },
    "gate": { "type": "object", "description": "WRITTEN BY ORCHESTRATOR ONLY: per-rule results from its own re-runs" },
    "usage": { "type": "object", "description": "WRITTEN BY ORCHESTRATOR ONLY: copied from Vibe's export.json (tokens, cost_usd, seconds, steps)" }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    }
  }
}
